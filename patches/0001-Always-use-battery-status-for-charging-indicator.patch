From 41871ba876fa040489fe36306df6e924b49a902f Mon Sep 17 00:00:00 2001
From: TheGamerKing561 <eyadtamer2121@gmail.com>
Date: Sat, 21 Mar 2026 22:12:14 +0200
Subject: [PATCH] Always use battery/status for charging indicator

In my experience, /sys/class/power_supply/bms/capacity gives the correct battery capacity for our device, but using BMS as the battery path breaks the battery charging indicator as BMS doesn't expose battery charging status.

This patch forces TWRP to always use /sys/class/power_supply/battery/status for the charging indicator regardless of the set TW_CUSTOM_BATTERY_PATH.
---
 twrp.cpp | 45 +++++++++++++++++++++++++--------------------
 1 file changed, 25 insertions(+), 20 deletions(-)

diff --git a/twrp.cpp b/twrp.cpp
index c9f597a..8346a67 100644
--- a/twrp.cpp
+++ b/twrp.cpp
@@ -421,10 +421,10 @@ int main(int argc, char **argv) {
 	static int lastVal = -1;
 
 	// Function to monitor battery in the background
-	auto monitorBatteryInBackground = [&]() {
-		while (true) {
+auto monitorBatteryInBackground = [&]() {
+	while (true) {
 #ifdef TW_USE_LEGACY_BATTERY_SERVICES
-			char cap_s[4];
+			char cap_s[16];
 #ifdef TW_CUSTOM_BATTERY_PATH
 			string capacity_file = EXPAND(TW_CUSTOM_BATTERY_PATH);
 			capacity_file += "/capacity";
@@ -433,35 +433,40 @@ int main(int argc, char **argv) {
 			FILE * cap = fopen("/sys/class/power_supply/battery/capacity","rt");
 #endif
 			if (cap) {
-				fgets(cap_s, 4, cap);
+				fgets(cap_s, sizeof(cap_s), cap);
 				fclose(cap);
 				lastVal = atoi(cap_s);
 				if (lastVal > 100)	lastVal = 101;
 				if (lastVal < 0)	lastVal = 0;
 			}
-#ifdef TW_CUSTOM_BATTERY_PATH
-			string status_file = EXPAND(TW_CUSTOM_BATTERY_PATH);
-			status_file += "/status";
-			cap = fopen(status_file.c_str(),"rt");
-#else
 			cap = fopen("/sys/class/power_supply/battery/status","rt");
-#endif
 			if (cap) {
-				fgets(cap_s, 2, cap);
+				fgets(cap_s, sizeof(cap_s), cap);
 				fclose(cap);
-				if (cap_s[0] == 'C')
+				if (strncmp(cap_s, "Charging", 8) == 0)
 					charging = '+';
 				else
 					charging = ' ';
 			}
 #else
-			auto battery_info = GetBatteryInfo();
-			if (battery_info.charging) {
-				charging = '+';
-			} else {
-				charging = ' ';
+			char cap_s[16];
+			FILE * cap = fopen("/sys/class/power_supply/battery/capacity","rt");
+			if (cap) {
+				fgets(cap_s, sizeof(cap_s), cap);
+				fclose(cap);
+				lastVal = atoi(cap_s);
+				if (lastVal > 100)	lastVal = 101;
+				if (lastVal < 0)	lastVal = 0;
+			}
+			cap = fopen("/sys/class/power_supply/battery/status","rt");
+			if (cap) {
+				fgets(cap_s, sizeof(cap_s), cap);
+				fclose(cap);
+				if (strncmp(cap_s, "Charging", 8) == 0)
+					charging = '+';
+				else
+					charging = ' ';
 			}
-			lastVal = battery_info.capacity;
 #endif
 			// Format the value based on the background updates
 			value = std::to_string(lastVal) + "%" + charging;
@@ -469,8 +474,8 @@ int main(int argc, char **argv) {
 
 			// Sleep for a specified interval (e.g., 1 second) before checking again
 			std::this_thread::sleep_for(std::chrono::seconds(1));
-		}
-	};
+	}
+};
 
 	// Create a thread for battery monitoring
 	static std::thread battery_monitor(monitorBatteryInBackground);
-- 
